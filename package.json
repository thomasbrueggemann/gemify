{
  "name": "gemify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Photograph a board game with your phone, let Claude turn it into a playable three.js multiplayer game.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "check": "node lib/check.mjs",
    "screenshots": "node tools/screenshots.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "@anthropic-ai/sdk": "^0.131.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
